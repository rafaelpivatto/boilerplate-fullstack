{
  "name": "@project/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "pnpm prisma:generate && nest build",
    "dev": "nest start --watch",
    "start": "node dist/src/main.js",
    "lint": "eslint .",
    "type-check": "pnpm prisma:generate && tsc --noEmit",
    "test": "pnpm prisma:generate && vitest run",
    "test:e2e": "docker compose -f ../../docker-compose.yml up -d db && DATABASE_URL=postgresql://app_user:app_password@localhost:5432/project pnpm db:migrate:deploy && DATABASE_URL=postgresql://app_user:app_password@localhost:5432/project pnpm prisma:generate && DATABASE_URL=postgresql://app_user:app_password@localhost:5432/project vitest run --config vitest.e2e.config.ts",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@project/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.0.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "supertest": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@project/config-ts": "workspace:*",
    "@prisma/client": "^7.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/supertest": "^6.0.0",
    "pg": "^8.0.0",
    "prisma": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0",
    "vite": "8.1.2",
    "vitest": "4.1.9"
  }
}
